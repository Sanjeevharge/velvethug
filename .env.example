# Velvet Hug — Production Environment Variables
PORT=8080
NODE_ENV=production

# PostgreSQL Cloud Database Connection (e.g. Supabase, Neon, Render, Railway, AWS RDS)
DATABASE_URL=postgres://username:password@host:5432/velvethug
DATABASE_SSL=true

# Initial Administrator Credentials (Bcrypt hashed at startup)
ADMIN_INITIAL_PASSWORD=velvethug
ADMIN_INITIAL_2FA_SECRET=0702

# Allowed CORS Origins (Comma-separated)
CORS_ORIGIN=https://velvethug.in,https://velvethug.onrender.com
