window.saveNewSku = function(e) {
  e.preventDefault();
  const code = qs('#newSkuCode')?.value.trim().toLowerCase();
  const name = qs('#newSkuName')?.value.trim();
  const category = qs('#newSkuCategory')?.value;
  const stock = parseInt(qs('#newSkuStock')?.value || '50', 10);
  const reorderLevel = parseInt(qs('#newSkuReorder')?.value || '15', 10);
  const location = qs('#newSkuLocation')?.value;
  const unitCost = qs('#newSkuCost')?.value.trim() || '₹12,000';

  if (!code || !name) return;

  if (!adminState.store.inventory) adminState.store.inventory = {};
  adminState.store.inventory[code] = {
    name,
    category,
    stock,
    reserved: 0,
    location,
    reorderLevel,
    unitCost
  };

  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Inventory', 'SKU Created', `Added new SKU ${code} (${name}) with ${stock} initial units`);
  window.closeAdminModal();
  adminToast(`✓ New SKU ${code} created successfully!`);
  renderActiveModule();
};

window.deleteSku = function(sku) {
  if (!confirm(`Are you sure you want to remove SKU "${sku}" from the warehouse inventory?`)) return;
  if (adminState.store.inventory && adminState.store.inventory[sku]) {
    const name = adminState.store.inventory[sku].name;
    delete adminState.store.inventory[sku];
    saveAdminState(adminState.store);
    logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Inventory', 'SKU Removed', `Removed SKU ${sku} (${name})`);
    adminToast(`SKU ${sku} deleted`);
    renderActiveModule();
  }
};

window.quickRestockAll = function() {
  const inv = adminState.store.inventory;
  if (!inv) return;
  Object.keys(inv).forEach(sku => {
    inv[sku].stock = (inv[sku].stock || 0) + 25;
  });
  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Inventory', 'Batch Restocked', 'Added +25 units across all catalog SKUs');
  adminToast('Batch Restock Complete: +25 units added to all SKUs');
  renderActiveModule();
};

window.addInventoryStock = function(sku) {
  const inv = adminState.store.inventory[sku];
  const qty = prompt(`Enter units to add for ${inv?.name || sku}:`, '25');
  if (qty && !isNaN(qty) && parseInt(qty, 10) > 0) {
    if (inv) {
      const added = parseInt(qty, 10);
      inv.stock = (inv.stock || 0) + added;
      saveAdminState(adminState.store);
      logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Inventory', 'Stock Added', `Added +${qty} units to ${inv.name || sku}`);
      
      // Real-time update in PostgreSQL company.inventory
      if (inv.dbId) {
        fetch(`/api/company/inventory/${inv.dbId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ stockAvailable: inv.stock, reason: `Admin added +${added} units` })
        }).catch(console.error);
      }

      adminToast(`Added +${qty} units to ${inv.name || sku}`);
      renderActiveModule();
    }
  }
};

window.deductInventoryStock = function(sku) {
  const inv = adminState.store.inventory[sku];
  const qty = prompt(`Enter units to deduct/dispatch for ${inv?.name || sku}:`, '5');
  if (qty && !isNaN(qty) && parseInt(qty, 10) > 0) {
    if (inv) {
      const deductVal = parseInt(qty, 10);
      if (inv.stock >= deductVal) {
        inv.stock -= deductVal;
        saveAdminState(adminState.store);
        logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Inventory', 'Stock Dispatched', `Dispatched -${qty} units from ${inv.name || sku}`);
        
        // Real-time update in PostgreSQL company.inventory
        if (inv.dbId) {
          fetch(`/api/company/inventory/${inv.dbId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ stockAvailable: inv.stock, reason: `Admin dispatched -${deductVal} units` })
          }).catch(console.error);
        }

        adminToast(`Dispatched -${qty} units from ${inv.name || sku}`);
        renderActiveModule();
      } else {
        alert(`Cannot dispatch ${deductVal} units. Available stock is only ${inv.stock} units.`);
      }
    }
  }
};

window.closeAdminModal = function() {
  const modal = document.getElementById('adminActiveModal');
  if (modal) modal.remove();
};

