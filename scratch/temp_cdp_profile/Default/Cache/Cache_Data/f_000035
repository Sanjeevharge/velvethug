window.saveNewReview = function(e) {
  e.preventDefault();
  const author = qs('#newRevAuthor')?.value.trim();
  const city = qs('#newRevCity')?.value.trim();
  const product = qs('#newRevProduct')?.value;
  const rating = parseInt(qs('#newRevRating')?.value || '5', 10);
  const comment = qs('#newRevComment')?.value.trim();
  const doctorRec = !!qs('#newRevDoctor')?.checked;

  if (!author || !comment) return;

  if (!adminState.store.reviews) adminState.store.reviews = [];

  adminState.store.reviews.unshift({
    id: `rev_${Date.now()}`,
    product,
    author,
    city,
    rating,
    date: new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
    comment,
    doctorRec,
    status: 'Approved'
  });

  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Reviews', 'Review Published', `Added review by ${author} for ${product}`);
  window.closeAdminModal();
  adminToast(`✓ Review published successfully!`);
  renderActiveModule();
};

window.toggleReviewApproval = function(idx) {
  const r = adminState.store.reviews[idx];
  if (!r) return;
  r.status = r.status === 'Approved' ? 'Hidden' : 'Approved';
  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Reviews', 'Review Status Changed', `Review by ${r.author} marked as ${r.status}`);
  adminToast(`Review by ${r.author} is now ${r.status}`);
  renderActiveModule();
};

window.removeReview = function(i) {
  const r = adminState.store.reviews[i];
  if (!r) return;
  if (!confirm(`Delete review from ${r.author}?`)) return;
  adminState.store.reviews.splice(i, 1);
  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Reviews', 'Review Deleted', `Deleted review by ${r.author}`);
  adminToast('Review removed');
  renderActiveModule();
};

