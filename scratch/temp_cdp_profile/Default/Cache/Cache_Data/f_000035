window.saveNewCoupon = function(e) {
  e.preventDefault();
  const code = qs('#newCouponCode')?.value.trim().toUpperCase();
  const discountPct = parseInt(qs('#newCouponPct')?.value || '20', 10);
  const maxDiscount = parseInt(qs('#newCouponMaxCap')?.value || '10000', 10);
  const minOrder = parseInt(qs('#newCouponMinOrder')?.value || '10000', 10);
  const rawDate = qs('#newCouponExpiry')?.value || '2026-12-31';

  if (!code) return;

  if (!adminState.store.coupons) adminState.store.coupons = [];

  // Check duplicate
  const existing = adminState.store.coupons.find(c => c.code === code);
  if (existing) {
    existing.discountPct = discountPct;
    existing.maxDiscount = maxDiscount;
    existing.minOrder = minOrder;
    existing.expiry = rawDate;
    existing.status = 'Active';
  } else {
    adminState.store.coupons.push({
      code,
      discountPct,
      maxDiscount,
      minOrder,
      expiry: rawDate,
      usageCount: 0,
      status: 'Active'
    });
  }

  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Promotions', 'Coupon Created', `Created/Updated promo coupon ${code} (${discountPct}% off, Cap ₹${maxDiscount})`);
  window.closeAdminModal();
  adminToast(`✓ Coupon ${code} published and live for shoppers!`);
  renderActiveModule();
};

window.deleteCoupon = function(idx) {
  const c = adminState.store.coupons[idx];
  if (!c) return;
  if (!confirm(`Delete coupon "${c.code}" permanently?`)) return;
  adminState.store.coupons.splice(idx, 1);
  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Promotions', 'Coupon Deleted', `Deleted coupon ${c.code}`);
  adminToast(`Coupon ${c.code} deleted`);
  renderActiveModule();
};

window.toggleCouponStatus = function(idx) {
  const c = adminState.store.coupons[idx];
  if (!c) return;
  c.status = c.status === 'Active' ? 'Inactive' : 'Active';
  saveAdminState(adminState.store);
  logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'Promotions', 'Coupon Status Changed', `${c.code} marked as ${c.status}`);
  adminToast(`Coupon ${c.code} is now ${c.status}`);
  renderActiveModule();
};

