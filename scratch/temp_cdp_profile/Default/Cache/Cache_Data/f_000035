export function initAdminTheme() {
  const savedTheme = localStorage.getItem('vh_admin_theme') || 'light';
  if (savedTheme === 'dark') {
    document.documentElement.setAttribute('data-theme', 'dark');
    document.body.classList.add('dark-theme');
  } else {
    document.documentElement.removeAttribute('data-theme');
    document.body.classList.remove('dark-theme');
  }
}

window.toggleAdminTheme = function() {
  const isDark = document.body.classList.contains('dark-theme') || document.documentElement.getAttribute('data-theme') === 'dark';
  if (isDark) {
    document.documentElement.removeAttribute('data-theme');
    document.body.classList.remove('dark-theme');
    localStorage.setItem('vh_admin_theme', 'light');
    adminToast('☀️ Admin Light Mode activated');
  } else {
    document.documentElement.setAttribute('data-theme', 'dark');
    document.body.classList.add('dark-theme');
    localStorage.setItem('vh_admin_theme', 'dark');
    adminToast('🌙 Admin Dark Mode activated');
  }
  renderAdminSidebar();
};

async function syncWithPostgresBackend() {
  try {
    // 1. Fetch live inventory from PostgreSQL (all 46 variant SKUs across all 18 products)
    const invRes = await fetch('/api/company/inventory').then(r => r.json());
    if (invRes.success && invRes.data && invRes.data.length > 0) {
      if (!adminState.store.inventory) adminState.store.inventory = {};
      invRes.data.forEach(item => {
        adminState.store.inventory[item.sku] = {
          dbId: item.id,
          productId: item.product_id,
          name: `${item.product_name} (${item.size})`,
          category: item.category_id ? (item.category_id.charAt(0).toUpperCase() + item.category_id.slice(1)) : 'Mattresses',
          stock: item.stock_available,
          reserved: item.stock_reserved,
          location: item.warehouse_loc || 'Central Logistics Hub',
          reorderLevel: item.reorder_level || 10,
          unitCost: `₹${Number(item.base_price).toLocaleString('en-IN')}`
        };
      });
      saveAdminState(adminState.store);
      if (adminState.activeModule === 'inventory') renderActiveModule();
    }

    // 2. Fetch live orders from PostgreSQL
    const ordRes = await fetch('/api/company/orders').then(r => r.json());
    if (ordRes.success && ordRes.data && ordRes.data.length > 0) {
      adminState.store.orders = ordRes.data.map(o => ({
        id: o.id,
        date: new Date(o.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
        customer: o.customer_name,
        phone: o.customer_phone || '+91 98800 11223',
        email: o.customer_email || '',
        address: o.delivery_address,
        items: (o.items || []).map(i => `${i.productName || i.product_name} (${i.size}) × ${i.quantity}`).join(', ') || 'Velvet Hug System',
        amount: Number(o.total_amount),
        paymentMode: o.payment_method === 'cod' ? 'Cash on Delivery (COD)' : 'Prepaid UPI / Card',
        paymentStatus: o.payment_status === 'paid' ? 'Reconciled & Cash Settled' : 'Pending Verification',
        deliveryStatus: o.order_status === 'delivered' ? 'Delivered' : (o.order_status === 'dispatched' ? 'Dispatched' : (o.order_status === 'manufacturing' ? 'Crafted in Lab' : 'Order Placed')),
        trackingId: o.tracking_number || 'BLR-EXP-99120',
        timeline: [
          { stage: 'Order Placed', timestamp: new Date(o.created_at).toLocaleString('en-IN'), note: 'Order registered in PostgreSQL users.orders' }
        ]
      }));
      saveAdminState(adminState.store);
      if (adminState.activeModule === 'customer_orders' || adminState.activeModule === 'completed_orders' || adminState.activeModule === 'dashboard') {
        renderActiveModule();
      }
    }
  } catch (err) {
    console.warn('[Admin PostgreSQL Sync]', err.message);
  }
}

