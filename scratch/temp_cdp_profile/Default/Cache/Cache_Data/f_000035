window.executeCustomerErasure = function() {
  const identifier = qs('#dpdpDeleteInput')?.value.trim();
  if (!identifier) {
    adminToast('Please enter a phone number or email to erase');
    return;
  }

  if (confirm(`CONFIRM PERMANENT ERASURE (DPDP Statutory):\nAre you sure you want to permanently erase all records for "${identifier}"?`)) {
    const curUser = localStorage.getItem('vh_user_data');
    if (curUser && curUser.includes(identifier)) {
      localStorage.removeItem('vh_user_data');
    }

    adminState.store.dpdpRequests.unshift({
      id: `dpdp_${Date.now()}`,
      customer: 'Anonymized User',
      identifier: identifier.replace(/.(?=.{4})/g, '*'),
      requestType: 'Right to be Forgotten (Full Erasure)',
      requestedAt: new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }),
      status: 'Completed',
      completedAt: new Date().toLocaleString('en-IN'),
      executedBy: `${adminState.currentUser.name} (${adminState.currentUser.roleLabel})`,
      logRef: `AUD-DPDP-${Math.floor(1000 + Math.random() * 9000)}`
    });

    saveAdminState(adminState.store);
    logAuditAction(adminState.currentUser.name, adminState.currentUser.roleLabel, 'DPDP Compliance', 'Customer Erasure Executed', `Erase personal data for ${identifier}`);
    adminToast(`All records for ${identifier} permanently erased under DPDP Act.`);
    renderActiveModule();
  }
};

