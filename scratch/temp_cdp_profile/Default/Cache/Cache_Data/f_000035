function adminToast(msg, dur = 2800) {
  const t = qs('#adminToast');
  if (!t) return;
  t.textContent = msg;
  t.style.display = 'block';
  t.style.opacity = '1';
  clearTimeout(adminState._toastTimer);
  adminState._toastTimer = setTimeout(() => {
    t.style.opacity = '0';
    setTimeout(() => t.style.display = 'none', 300);
  }, dur);
}

