window.advanceOrderStatus = function(idx) {
  const order = adminState.store.orders[idx];
  if (!order) return;
  const stages = ['Order Placed', 'Crafted in Lab', 'Dispatched', 'Delivered'];
  const curStage = order.deliveryStatus || 'Order Placed';
  const curIdx = stages.indexOf(curStage);
  const nextStage = stages[curIdx + 1] || 'Delivered';

  order.deliveryStatus = nextStage;
  const now = new Date().toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });

  order.timeline = order.timeline || [];
  order.timeline.push({
    stage: nextStage,
    timestamp: now,
    note: nextStage === 'Crafted in Lab' ? 'Five-layer mattress precision assembly completed in lab'
      : (nextStage === 'Dispatched' ? `Dispatched via White-Glove Logistics (Tracking ${order.trackingId})`
      : 'Delivered to customer address. COD Cash Reconciled & Settled.')
  });

  if (nextStage === 'Delivered' && order.paymentMode.includes('COD')) {
    order.paymentStatus = 'Reconciled & Cash Settled';
  }

  saveAdminState(adminState.store);

  // Sync back to consumer user profile if this is the active user
  try {
    const userRaw = localStorage.getItem('vh_user_data');
    if (userRaw) {
      const u = JSON.parse(userRaw);
      if (u.orders) {
        const matching = u.orders.find(o => o.id === order.id);
        if (matching) {
          matching.status = nextStage;
          matching.deliveryStatus = nextStage;
          matching.timeline = order.timeline;
          localStorage.setItem('vh_user_data', JSON.stringify(u));
        }
      }
    }
  } catch (e) {}

  adminToast(`Order ${order.id} advanced to: ${nextStage}`);
  renderActiveModule();
};

