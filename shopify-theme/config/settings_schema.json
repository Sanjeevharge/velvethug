[
  {
    "name": "theme_info",
    "theme_name": "Velvet Hug Luxury OS 2.0",
    "theme_version": "1.0.0",
    "theme_author": "Velvet Hug",
    "theme_documentation_url": "https://velvethug.in",
    "theme_support_url": "https://velvethug.in"
  },
  {
    "name": "Logo & Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Official Header Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 30,
        "max": 200,
        "step": 5,
        "default": 55,
        "unit": "px",
        "label": "Logo Width"
      }
    ]
  },
  {
    "name": "Colors & Velvet Aesthetic",
    "settings": [
      {
        "type": "color",
        "id": "color_primary_bg",
        "label": "Primary Midnight Background",
        "default": "#0b0f19"
      },
      {
        "type": "color",
        "id": "color_card_bg",
        "label": "Card Glassmorphism Background",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "color_accent_gold",
        "label": "Champagne Gold Accent",
        "default": "#f59e0b"
      },
      {
        "type": "color",
        "id": "color_accent_burgundy",
        "label": "Velvet Burgundy Accent",
        "default": "#831843"
      }
    ]
  },
  {
    "name": "Festival & Promo Banner",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_festival_banner",
        "label": "Enable Timed Promo Banner",
        "default": true
      },
      {
        "type": "text",
        "id": "festival_promo_code",
        "label": "Active Promo Coupon Code",
        "default": "FOUNDING15"
      },
      {
        "type": "text",
        "id": "festival_discount_headline",
        "label": "Promo Headline",
        "default": "First 1,000 Sleep Partners — 15% Lifetime Price Lock"
      },
      {
        "type": "text",
        "id": "festival_end_datetime",
        "label": "Festival Countdown End Datetime (ISO format)",
        "default": "2026-11-30T23:59:59"
      }
    ]
  },
  {
    "name": "WhatsApp & Doctor Support",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_business_number",
        "label": "WhatsApp Business Number (with country code, e.g. 919876543210)",
        "default": "918069008358"
      },
      {
        "type": "text",
        "id": "doctor_consultant_name",
        "label": "Consulting Doctor Name",
        "default": "Dr. Alok Verma, MS Ortho"
      },
      {
        "type": "text",
        "id": "doctor_hospital",
        "label": "Doctor Institution / Hospital",
        "default": "Senior Consultant Spine & Joint Specialist"
      }
    ]
  },
  {
    "name": "Founding Sleep Partners",
    "settings": [
      {
        "type": "text",
        "id": "founding_target",
        "label": "Founding Partners Target Count",
        "default": "1000"
      },
      {
        "type": "text",
        "id": "founding_claimed",
        "label": "Current Claimed Count",
        "default": "348"
      }
    ]
  }
]
