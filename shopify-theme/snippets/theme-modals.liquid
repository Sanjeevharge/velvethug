{% comment %}
  Velvet Hug - Core Storefront Interactive Overlays & Modals
  Includes Cart Drawer, Sleep Quiz Modal, Doctor Consultation, PDP Modal, B2B Gifting, and Toasts
{% endcomment %}

<!-- CART DRAWER -->
<div id="cartDrawerBackdrop" class="cart-drawer-backdrop" role="dialog" aria-modal="true" onclick="if(event.target===this) closeCartDrawer();">
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <div class="cart-drawer-title">
        <span>🛍️ Your Velvet Hug Bag</span>
      </div>
      <button class="modal-close-icon" onclick="closeCartDrawer()" aria-label="Close cart">✕</button>
    </div>

    <!-- Free Delivery & Trial Badge -->
    <div style="background:var(--purple-50, #FBF8FF); border-bottom:1px solid var(--purple-100, #EAE0F5); padding:10px 18px; font-size:0.8rem; color:var(--purple-900, #2D114D); display:flex; justify-content:space-between; align-items:center;">
      <span>✨ 100-Night Free Trial Included</span>
      <span style="font-weight:700; color:var(--accent-emerald, #059669);">Pan-India Free Shipping</span>
    </div>

    <!-- Cart Items Scroll -->
    <div id="cartItemsContainer" class="cart-items-scroll"></div>

    <!-- Pincode Check & Coupon -->
    <div style="padding:12px 18px; background:#FFFFFF; border-top:1px solid var(--purple-100, #EAE0F5);">
      <div style="display:flex; gap:8px; margin-bottom:8px;">
        <input type="text" id="cartPincodeInput" placeholder="Enter Delivery PIN code" maxlength="6" style="flex:1; border:1px solid var(--purple-200, #DDD0ED); border-radius:6px; padding:7px 10px; font-size:0.82rem;" />
        <button class="btn btn-outline" style="padding:7px 12px; font-size:0.8rem;" onclick="checkPinCode()">Check</button>
      </div>
      <div id="pincodeStatus" style="font-size:0.75rem; margin-bottom:10px;"></div>

      <div style="display:flex; gap:8px;">
        <input type="text" id="cartCouponInput" placeholder="Discount Code (e.g. FESTIVE40)" style="flex:1; border:1px solid var(--purple-200, #DDD0ED); border-radius:6px; padding:7px 10px; font-size:0.82rem; text-transform:uppercase;" />
        <button class="btn btn-primary" style="padding:7px 14px; font-size:0.8rem;" onclick="applyCartCoupon()">Apply</button>
      </div>
    </div>

    <!-- Cart Footer & Checkout -->
    <div class="cart-drawer-footer">
      <div id="cartDiscountRow" style="display:none; justify-content:space-between; font-size:0.85rem; margin-bottom:6px;"></div>
      <div class="cart-totals-row">
        <span>Order Total</span>
        <span id="cartTotalDisplay" style="font-size:1.3rem; font-weight:800; color:var(--purple-950, #1D0636);">₹0</span>
      </div>
      <div style="font-size:0.78rem; color:var(--text-muted, #786C8D); margin-bottom:12px; text-align:right;">
        Or <span id="cartEmiDisplay" style="font-weight:700; color:var(--purple-800, #4A1D75);">₹0/mo</span> with No-Cost EMI
      </div>
      <a href="{{ routes.checkout_url | default: '/checkout' }}" class="btn btn-primary btn-block btn-lg" style="text-align:center; display:block; text-decoration:none;">
        Proceed to Secure Checkout →
      </a>
      <div style="text-align:center; margin-top:8px; font-size:0.75rem; color:#94a3b8;">
        🔒 Encrypted 256-bit Razorpay / UPI / Card Checkout
      </div>
    </div>
  </div>
</div>

<!-- SLEEP QUIZ MODAL -->
<div id="quizModal" class="modal-backdrop" role="dialog" aria-modal="true" onclick="if(event.target===this) closeQuizModal();">
  <div class="modal-card quiz-modal-card">
    <button class="modal-close-icon" onclick="closeQuizModal()" aria-label="Close quiz">✕</button>
    <div id="quizModalBody"></div>
  </div>
</div>

<!-- DOCTOR CONSULTATION MODAL -->
<div id="doctorModal" class="modal-backdrop" role="dialog" aria-modal="true" onclick="if(event.target===this) closeDoctorModal();">
  <div class="modal-card" style="max-width:480px; width:100%; border-radius:16px;">
    <button class="modal-close-icon" onclick="closeDoctorModal()" aria-label="Close">✕</button>
    <div style="text-align:center; margin-bottom:16px;">
      <div style="font-size:3rem; margin-bottom:8px;">🩺</div>
      <h3 style="font-size:1.3rem; color:var(--purple-950, #1D0636); margin-bottom:4px;">Orthopedic Sleep Consultation</h3>
      <div style="font-size:0.85rem; color:var(--purple-800, #4A1D75); font-weight:600;">Dr. Alok Verma, MS Ortho</div>
      <p style="font-size:0.78rem; color:#64748b; margin:2px 0 0 0;">Senior Spine & Joint Specialist · Max Healthcare</p>
    </div>

    <div style="background:var(--purple-50, #FBF8FF); border:1px solid var(--purple-100, #EAE0F5); border-radius:10px; padding:14px; margin-bottom:18px;">
      <div style="font-size:0.78rem; font-weight:700; color:var(--purple-900, #2D114D); margin-bottom:4px;">Regarding Mattress: <span id="doctorProductTitle">Velvet Hug Reserve+</span></div>
      <div id="doctorQuoteText" style="font-size:0.84rem; color:var(--text-secondary, #4A3E5C); font-style:italic; line-height:1.45;"></div>
    </div>

    <button id="btnDoctorWhatsApp" class="btn btn-whatsapp" style="width:100%; display:flex; align-items:center; justify-content:center; gap:8px;">
      <span>💬 Connect with Dr. Verma on WhatsApp</span>
    </button>
  </div>
</div>

<!-- PRODUCT DETAIL MODAL (PDP Quick View) -->
<div id="pdpModal" class="modal-backdrop" role="dialog" aria-modal="true" onclick="if(event.target===this) closeProductDetail();">
  <div class="pdp-modal-content">
    <button class="modal-close-icon" onclick="closeProductDetail()" aria-label="Close product view">✕</button>
    <div id="pdpModalBody"></div>
  </div>
</div>

<!-- CORPORATE GIFTING MODAL -->
<div id="corporateGiftingModal" class="modal-backdrop" role="dialog" aria-modal="true" onclick="if(event.target===this) closeCorporateGiftingModal();">
  <div class="modal-card" style="max-width:500px; width:100%; border-radius:16px;">
    <button class="modal-close-icon" onclick="closeCorporateGiftingModal()" aria-label="Close">✕</button>
    <h3 style="font-size:1.3rem; color:var(--purple-950, #1D0636); margin-bottom:6px;">Corporate & Bulk Gifting</h3>
    <p style="font-size:0.85rem; color:var(--text-muted, #786C8D); margin-bottom:18px;">Custom branded wellness packages, hotel suites, and executive hampers.</p>
    <form onsubmit="submitB2BQuote(event)" style="display:flex; flex-direction:column; gap:12px;">
      <input type="text" placeholder="Company / Organization Name" class="form-input" required />
      <input type="text" placeholder="Contact Person & Designation" class="form-input" required />
      <input type="tel" placeholder="Official WhatsApp / Phone Number" class="form-input" required />
      <input type="number" placeholder="Estimated Quantity (Min. 10 Units)" min="10" class="form-input" required />
      <button type="submit" class="btn btn-primary" style="margin-top:6px;">Submit Quotation Request →</button>
    </form>
  </div>
</div>

<!-- TOAST CONTAINER -->
<div id="toast" class="toast-notification"></div>
