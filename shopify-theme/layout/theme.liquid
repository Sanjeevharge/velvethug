      <div class="logo-text-wrap">
        <span class="logo-title">Velvet Hug</span>
        <span class="logo-subtitle">Be Held, Every Night</span>
      </div>
    </a>

    <!-- Primary Navigation -->
    <nav aria-label="Main navigation" class="nav-wrapper">
      <ul class="nav-links" role="list">
        <li><a class="nav-link active" data-page="home" href="/" onclick="goToPage('home')">Home</a></li>
        <li><a class="nav-link" data-page="mattresses" href="/mattresses" onclick="goToPage('mattresses')">Mattresses</a></li>
        <li><a class="nav-link" data-page="pillows" href="/pillows" onclick="goToPage('pillows')">Pillows</a></li>
        <li><a class="nav-link" data-page="accessories" href="/accessories" onclick="goToPage('accessories')">Accessories</a></li>
        <li><a class="nav-link" data-page="emi" href="/emi" onclick="goToPage('emi')">EMI Plans</a></li>
        <li>
          <a class="nav-link" href="/quiz" id="quizBtn" onclick="if(window.openQuiz) { openQuiz(); return false; }">
            Sleep Quiz <span class="nav-badge-pill">New</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Right Actions -->
    <div class="header-right-group">
      <div class="header-actions">
        <!-- Dark / Light Mode Conversion Button -->
        <button class="action-icon-btn theme-toggle-btn" id="consumerThemeToggleBtn" title="Switch Dark / Light Mode" aria-label="Toggle dark mode" onclick="window.toggleConsumerTheme()">
          <span id="themeToggleIcon" style="display:flex;align-items:center;justify-content:center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </span>
        </button>

        <!-- Search Button -->
        <button class="action-icon-btn" id="headerSearchBtn" title="Search catalog" aria-label="Open search" onclick="if(window.openSearch) openSearch();">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        </button>

        <!-- Account / Profile Button (Person Outline) -->
        <button class="action-icon-btn" id="accountBtn" title="My Account &amp; Profile" aria-label="My Account" onclick="window.goToAccount ? window.goToAccount() : goToPage('account');">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </button>

        <!-- Shopping Cart Button (Amazon/Duroflex Trolley Icon) -->
        <button class="action-icon-btn" id="cartBtn" title="Shopping Cart" aria-label="Shopping cart" style="position:relative;" onclick="if(window.openCart){openCart();}">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="action-badge" id="cartBadge">0</span>
        </button>
      </div>
    </div>
  </div>
</header>

