  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

  <!-- Theme Stylesheet (Unified Production CSS) -->
  {{ 'main.css' | asset_url | stylesheet_tag }}

  <!-- Three.js for 3D Layer Visualizer -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" defer></script>

  <!-- Global Shopify Asset CDN Resolver & Navigation Helpers -->
  <script>
    window.SHOPIFY_CDN = {{ 'logo.jpeg' | asset_url | json }}.replace('logo.jpeg', '');

    // Global SPA Page Navigation
    window.goToPage = function(page) {
      if (window.navigateTo) {
        window.navigateTo(page);
      } else {
        document.querySelectorAll('.page-view').forEach(function(v) {
          v.classList.remove('active');
          v.style.display = 'none';
        });
        var el = document.getElementById('view-' + page);
        if (el) {
          el.classList.add('active');
          el.style.display = 'block';
        }
        document.querySelectorAll('.nav-link').forEach(function(l) {
          l.classList.toggle('active', l.getAttribute('data-page') === page);
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };

    window.goToAccount = function() {
      if (window.navigateTo) {
        window.navigateTo('account');
      } else if (window.goToPage) {
        window.goToPage('account');
      }
    };

    window.openSearch = function() {
      var modal = document.getElementById('searchModal');
      if (modal) {
        modal.classList.add('active');
        modal.style.display = 'flex';
        setTimeout(function() {
          var input = document.getElementById('searchInput');
          if (input) input.focus();
        }, 80);
      }
    };

    window.closeSearch = function() {
      var modal = document.getElementById('searchModal');
      if (modal) {
        modal.classList.remove('active');
        modal.style.display = 'none';
      }
    };

    window.searchQuickTag = function(term) {
      var input = document.getElementById('searchInput');
      if (input) {
        input.value = term;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    };

    window.openCart = function() {
      if (window._openCartReal) {
        window._openCartReal();
      } else {
        var drawer = document.getElementById('cartDrawerBackdrop');
        if (drawer) {
          drawer.classList.add('active', 'open');
          drawer.style.display = 'flex';
        }
      }
    };

    window.closeCart = function() {
      if (window._closeCartReal) {
        window._closeCartReal();
      } else {
        var drawer = document.getElementById('cartDrawerBackdrop');
        if (drawer) {
          drawer.classList.remove('active', 'open');
          drawer.style.display = 'none';
        }
      }
    };

    window.openQuiz = function() {
      if (window._openQuizReal) {
        window._openQuizReal();
      } else {
        var quiz = document.getElementById('quizModalBackdrop');
        if (quiz) {
          quiz.classList.add('active');
          quiz.style.display = 'flex';
          if (window.renderQuizStep) window.renderQuizStep();
        }
      }
    };

    window.closeQuiz = function() {
      var quiz = document.getElementById('quizModalBackdrop');
      if (quiz) {
        quiz.classList.remove('active');
        quiz.style.display = 'none';
      }
    };

    window.openLoginModal = function() {
      var m = document.getElementById('loginModal');
      if (m) {
        m.classList.add('active');
        m.style.display = 'flex';
      }
    };

    window.closeLoginModal = function() {
      var m = document.getElementById('loginModal');
      if (m) {
        m.classList.remove('active');
        m.style.display = 'none';
      }
    };

    window.toggleConsumerTheme = function() {
      var isDark = document.body.classList.contains('dark-theme') || document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        document.body.classList.remove('dark-theme');
        try { localStorage.setItem('vh_consumer_theme', 'light'); } catch(e){}
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.body.classList.add('dark-theme');
        try { localStorage.setItem('vh_consumer_theme', 'dark'); } catch(e){}
      }
      var icon = document.getElementById('themeToggleIcon');
      if (icon) {
        icon.innerHTML = (!isDark)
          ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>'
          : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
      }
    };

    // Global ESC key listener to close ANY modal immediately
    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        window.closeSearch();
        window.closeCart();
        window.closeQuiz();
        window.closeLoginModal();
        document.querySelectorAll('.modal-backdrop.active, .cart-drawer-backdrop.active, .promo-modal-backdrop.active').forEach(function(el) {
          el.classList.remove('active', 'open');
          el.style.display = 'none';
        });
        document.body.style.overflow = '';
      }
    });

    try {
      if (localStorage.getItem('vh_consumer_theme') === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    } catch(e){}

    // Global image fallback: automatically load from Shopify CDN if relative path fails
    document.addEventListener('error', function(e) {
      if (e.target && e.target.tagName === 'IMG') {
        var src = e.target.getAttribute('src');
        if (src && window.SHOPIFY_CDN && !src.startsWith(window.SHOPIFY_CDN)) {
          var filename = src.split('/').pop().split('?')[0];
          e.target.src = window.SHOPIFY_CDN + filename;
        }
      }
    }, true);
  </script>
</head>
