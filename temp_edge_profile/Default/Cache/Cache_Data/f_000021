/* ===========================================================
   Velvet Hug — CSS Design Tokens
   Midnight Blue, Warm Ivory, Deep Velvet Blue,
   Muted Violet, Champagne Gold
   =========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

/* ── Reset ─────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: var(--font-body);
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
a { text-decoration: none; color: inherit; }
button { cursor: pointer; border: none; background: transparent; font-family: inherit; }
img { display: block; max-width: 100%; }
input, select, textarea { font-family: inherit; }

/* ── CSS Variables ─────────────────────────── */
:root {
  /* Brand Palette */
  --midnight-blue:       #0A1128;
  --warm-ivory:          #FDFBF7;
  --deep-velvet-blue:    #1B263B;
  --muted-violet:        #4C3F5E;
  --champagne-gold:      #D4AF37;

  /* Derived Tints */
  --muted-violet-light:  #F5F2F9;
  --champagne-gold-light: #FBF6E2;
  --champagne-gold-border: rgba(212,175,55,0.3);
  --accent-emerald:      #059669;
  --accent-emerald-light: #ECFDF5;
  --danger:              #DC2626;

  /* Backgrounds */
  --bg-primary:          #FDFBF7;
  --bg-secondary:        #F7F5F0;
  --bg-surface:          #FFFFFF;
  --bg-midnight:         #0A1128;
  --bg-velvet-blue:      #1B263B;

  /* Glassmorphism & Depth Tokens */
  --glass-bg:            rgba(255, 255, 255, 0.72);
  --glass-border:        1px solid rgba(255, 255, 255, 0.45);
  --glass-border-dark:   1px solid rgba(255, 255, 255, 0.12);
  --glass-shadow:        0 20px 40px -15px rgba(10, 17, 40, 0.08);
  --glass-blur:          blur(16px);
  --category-accent-glow: rgba(212, 175, 55, 0.15);

  /* Typography */
  --font-serif:     'Lora', Georgia, serif;
  --font-body:      'Plus Jakarta Sans', system-ui, sans-serif;
  --font-heading:   'Plus Jakarta Sans', system-ui, sans-serif;

  /* Text */
  --text-primary:   #0A1128;
  --text-secondary: #4C3F5E;
  --text-muted:     #8C8AAA;

  /* Radii */
  --radius-xs:  4px;
  --radius-sm:  8px;
  --radius-md:  12px;
  --radius-lg:  16px;
  --radius-xl:  24px;
  --radius-2xl: 32px;
  --radius-full: 9999px;

  /* Shadows */
  --shadow-subtle:  0 1px 4px rgba(10,17,40,0.05);
  --shadow-card:    0 4px 18px rgba(10,17,40,0.08);
  --shadow-hover:   0 14px 40px rgba(10,17,40,0.13);
  --shadow-modal:   0 25px 80px rgba(10,17,40,0.25);
  --shadow-float:   0 20px 40px -15px rgba(10, 17, 40, 0.12);

  /* Transitions */
  --transition-fast:   0.15s ease;
  --transition-normal: 0.25s ease;
  --transition-smooth: 0.35s cubic-bezier(0.16,1,0.3,1);

  /* Layout */
  --max-width:  1200px;
  --container-pad: 24px;
}

/* ── Utility ────────────────────────────────── */
.container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--container-pad); }
.section-header { text-align: center; margin-bottom: 42px; }
.section-tag {
  font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--muted-violet); margin-bottom: 10px; display: block;
}
.section-header h2 {
  font-family: var(--font-serif); font-size: clamp(1.8rem,3vw,2.5rem);
  font-weight: 700; color: var(--midnight-blue); margin-bottom: 12px; letter-spacing: -0.025em;
}
.section-header p { font-size: 1.02rem; color: var(--text-secondary); max-width: 560px; margin: 0 auto; line-height: 1.65; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 7px; padding: 12px 22px; border-radius: var(--radius-sm);
  font-weight: 700; font-size: 0.88rem; line-height: 1;
  transition: all var(--transition-fast); cursor: pointer; border: 1.5px solid transparent;
  letter-spacing: 0.02em;
}
.btn-primary {
  background: var(--midnight-blue); color: #FDFBF7; border-color: var(--midnight-blue);
  box-shadow: 0 4px 14px rgba(10,17,40,0.2);
}
.btn-primary:hover { background: #12193A; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(10,17,40,0.3); }
.btn-gold {
  background: var(--champagne-gold); color: var(--midnight-blue); border-color: var(--champagne-gold);
  box-shadow: 0 4px 14px rgba(212,175,55,0.3);
}
.btn-gold:hover { background: #C9A425; transform: translateY(-1px); }
.btn-outline {
  background: transparent; color: var(--midnight-blue); border-color: rgba(10,17,40,0.3);
}
.btn-outline:hover { background: var(--midnight-blue); color: #FDFBF7; border-color: var(--midnight-blue); }
.btn-outline-light {
  background: transparent; color: #FDFBF7; border-color: rgba(253,251,247,0.4);
}
.btn-outline-light:hover { background: rgba(253,251,247,0.1); }
.btn-sm { padding: 7px 14px; font-size: 0.78rem; }
.btn-lg { padding: 15px 32px; font-size: 0.95rem; }
.btn-block { width: 100%; justify-content: center; }

/* Badges */
.badge {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 3px 8px; border-radius: var(--radius-xs); font-size: 0.68rem; font-weight: 700;
}
.badge-founding { background: var(--champagne-gold-light); color: var(--midnight-blue); border: 1px solid var(--champagne-gold-border); }
.badge-sale { background: #FEE2E2; color: var(--danger); }
.badge-new { background: var(--accent-emerald-light); color: var(--accent-emerald); }
.badge-bestsel { background: var(--muted-violet-light); color: var(--muted-violet); }

/* Form Inputs */
.form-input {
  width: 100%; background: var(--bg-secondary);
  border: 1.5px solid rgba(76,63,94,0.18);
  border-radius: var(--radius-sm); padding: 10px 14px;
  font-size: 0.9rem; color: var(--text-primary);
  transition: border-color var(--transition-fast); outline: none;
}
.form-input:focus { border-color: var(--midnight-blue); background: #fff; box-shadow: 0 0 0 3px rgba(10,17,40,0.05); }
.form-label { font-size: 0.78rem; font-weight: 700; color: var(--midnight-blue); margin-bottom: 5px; display: block; letter-spacing: 0.03em; }

/* Rating Stars */
.stars { color: #F59E0B; font-size: 0.8rem; letter-spacing: 1px; }
.rating-text { font-size: 0.75rem; color: var(--text-muted); }

/* Page View Switching */
.page-view { display: none; }
.page-view.active { display: block; }

/* 3D Viewer Placeholder */
.viewer-3d-wrap {
  background: linear-gradient(135deg, var(--bg-midnight) 0%, var(--deep-velvet-blue) 100%);
  border-radius: var(--radius-md); overflow: hidden; position: relative;
  height: 300px; display: flex; align-items: center; justify-content: center;
}
.viewer-3d-canvas { width: 100%; height: 100%; position: absolute; inset: 0; }
.viewer-3d-controls {
  position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%);
  display: flex; gap: 8px; background: rgba(253,251,247,0.1); backdrop-filter: blur(6px);
  padding: 6px 12px; border-radius: var(--radius-full); border: 1px solid rgba(255,255,255,0.15);
}
.viewer-3d-btn { background: transparent; color: rgba(253,251,247,0.85); font-size: 0.78rem; font-weight: 600; padding: 3px 10px; border-radius: var(--radius-full); }
.viewer-3d-btn.active, .viewer-3d-btn:hover { background: rgba(253,251,247,0.15); color: #FDFBF7; }

/* Notifications */
.notification-toast {
  position: fixed; top: 90px; right: 24px;
  background: var(--midnight-blue); color: #FDFBF7;
  padding: 12px 18px; border-radius: var(--radius-sm);
  font-size: 0.86rem; font-weight: 600; z-index: 3000;
  opacity: 0; pointer-events: none;
  transform: translateX(100px);
  transition: all var(--transition-normal);
  max-width: 340px; border-left: 4px solid var(--champagne-gold);
  box-shadow: 0 10px 25px rgba(10,17,40,0.25);
}
.notification-toast.show {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(0);
}

/* Theme Toggle Button */
.theme-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: var(--radius-sm);
  background: var(--bg-secondary);
  border: 1px solid rgba(76,63,94,0.14);
  color: var(--text-primary);
  font-size: 1.1rem;
  transition: all var(--transition-fast);
  cursor: pointer;
  padding: 0;
  flex-shrink: 0;
}

.theme-toggle-btn:hover {
  background: var(--muted-violet-light);
  border-color: var(--champagne-gold);
  transform: translateY(-1px);
}

